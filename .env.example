# ===================================================
# THULIR SPECIAL SCHOOL - ENVIRONMENT CONFIGURATION
# ===================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ---------------------------------------------------
# FIREBASE CLIENT CONFIGURATION (Browser Safe)
# ---------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ---------------------------------------------------
# OPTIONAL: FIREBASE ADMIN SDK (Cloud Sync Only - Not Required)
# ---------------------------------------------------
# The application has built-in resilient persistent storage for events,
# inquiries, gallery, and settings. These keys are purely optional if you
# wish to dual-sync records with Google Cloud Firestore.
# FIREBASE_ADMIN_PROJECT_ID=your_project_id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# ---------------------------------------------------
# AUTHORIZED ADMIN CREDENTIALS (Server-Side Only)
# ---------------------------------------------------
ADMIN_USERNAME=admin@thulirschool.com
ADMIN_PASSWORD=ThulirAdmin@2026

# ---------------------------------------------------
# RESEND EMAIL SERVICE (Server-Side Only - Secret)
# ---------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_NOTIFICATION_EMAIL=admin@thulirspecialschool.org
SENDER_EMAIL_ADDRESS=notifications@thulirspecialschool.org

# ---------------------------------------------------
# CLOUDINARY MEDIA SERVICE (Server-Side Only - Secret)
# ---------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
